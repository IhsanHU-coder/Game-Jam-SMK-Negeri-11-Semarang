  dialogueText: {fileID: 1498774440}
  textCanvasGroup: {fileID: 1498774439}
  continueButton: {fileID: 1886081679}
  openingDialogueLines:
  - Tanah ini akhirnya kembali pulih.
  - Setelah sekian lama, tanah ini telah kembali memiliki kondisi yang layak untuk
    kehidupan baru.
  - Kini saatnya menanam kembali pohon-pohon yang akan menghidupkan tanah ini.
  dialogueLines:
  - Semua benih sudah ditanam.
  - Sekarang waktunya menyiram tanaman.
  endingDialogueLines:
  - Akhirnya tugasku selesai
  - Sekarang giliran alam untuk memperbaiki dirinya sendiri
  typingSpeed: 0.04
  holdDuration: 1.5
  fadeOutDuration: 0.6
  autoAdvance: 1
